# Key names only. Never commit real values -- .env is gitignored.
# Copy to .env (or just export these in your shell) to enable the live NARRATE provider.

# API token for the configured LLM provider. Read from the environment only.
PERMEA_LLM_TOKEN=

# Deployment identifier. This is the value sent in the request's "model" field.
PERMEA_LLM_ENDPOINT_ID=

# Full chat-completions URL the live call POSTs to. No built-in default.
PERMEA_LLM_BASE_URL=

# Optional. Provider selector for permea_explain; defaults to "configured".
PERMEA_EXPLAIN_PROVIDER=
